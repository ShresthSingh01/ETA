# ==============================================================================
# RailETA Local Configuration (.env)
# ==============================================================================
# Paste your RailRadar Live API Key below to enable genuine live external telemetry:
RAILRADAR_API_KEY=your_api_key_here

# Base URL for RailRadar Live API endpoint (default: https://api.railradar.in/v1)
RAILRADAR_BASE_URL=https://api.railradar.in/v1
