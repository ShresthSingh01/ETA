# ==============================================================================
# GaTi Environment Configuration
# ==============================================================================

# Runtime environment: development | production
APP_ENV=development

# RailRadar credentials for live telemetry mode
RAILRADAR_API_KEY=your_api_key_here
RAILRADAR_BASE_URL=https://api.railradar.in/v1

# Optional: override prediction audit log path
# For Vercel, this should point to /tmp (default is auto-selected as /tmp on Vercel)
PREDICTION_LOG_PATH=logs/prediction_eval_log.jsonl

# Optional logging level (INFO, WARNING, ERROR, DEBUG)
LOG_LEVEL=INFO
